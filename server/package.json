{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "mig:gen": "pnpm build && DRIZZLE_SCHEMA=./dist/db/schema/*.js drizzle-kit generate",
    "mig:run": "drizzle-kit migrate",
    "db:reset:sql": "tsx devtools/scripts/reset-db.ts",
    "db:reset": "pnpm db:reset:sql && pnpm mig:run && pnpm seed",
    "generate:schema": "tsx devtools/scripts/generate-schema.ts",
    "seed": "tsx devtools/scripts/seed.ts",
    "seed:demo": "tsx devtools/scripts/seed-demo.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.11.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/lodash": "^4.17.27",
    "@types/node": "^25.9.9",
    "@types/pg": "^8.23.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "jiti": "^2.7.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1173.0",
    "@aws-sdk/lib-storage": "^3.1173.0",
    "@aws-sdk/s3-request-presigner": "^3.1173.0",
    "@fastify/cors": "^11.4.3",
    "@fastify/multipart": "^9.4.0",
    "@gqloom/core": "^0.16.2",
    "@gqloom/drizzle": "^0.11.0",
    "@gqloom/zod": "^0.15.2",
    "better-auth": "^1.7.26",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "4.0.1",
    "graphql": "^16.15.0",
    "lodash": "^4.18.1",
    "mercurius": "^16.12.2",
    "node-cron": "^4.6.0",
    "pg": "^8.23.1",
    "zod": "^3.25.76"
  },
  "pnpm": {
    "overrides": {
      "prisma": "^7.10.1",
      "@prisma/client": "^7.10.1",
      "mysql2": "^3.24.6",
      "effect": "^3.22.1",
      "lodash": "^4.18.1"
    }
  }
